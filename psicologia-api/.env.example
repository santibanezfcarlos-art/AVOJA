# Plantilla de variables para el servicio psicologia-carlos-calendar-api en Render
# IMPORTANTE: NO pegar secretos reales en este archivo ni subirlos a GitHub.
# Copiar SOLO los nombres de variables a Render > Environment.
# Todos los cobros permanecen DESACTIVADOS por defecto.

PSICOLOGIA_WEBPAY_MODE=disabled
PSICOLOGIA_BOOKINGS_ENABLED=false
PSICOLOGIA_WEBPAY_PRODUCTION_APPROVED=false
PSICOLOGIA_API_PUBLIC_URL=https://psicologia-carlos-calendar-api.onrender.com

# Obtener código/API Key de Transbank al completar contratación.
# Son credenciales exclusivas del comercio de psicología.
PSICOLOGIA_WEBPAY_COMMERCE_CODE=
PSICOLOGIA_WEBPAY_API_KEY=

# Debe apuntar a una BD PostgreSQL propia PERSISTENTE y con respaldos.
# Sin base de datos las reservas pagadas no pueden habilitarse.
PSICOLOGIA_DATABASE_URL=

# Variable existente: dirección iCal privada, conservar la que ya está en Render.
# GOOGLE_CALENDAR_ICS_URL=NO_INCLUIR_AQUI
